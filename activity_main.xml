<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12201C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Habit Focus"
            android:textColor="#F4EFE4"
            android:textSize="28sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Focus mode off hai"
            android:textColor="#A9BDB2"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Block karne ke liye apps chuno:"
            android:textColor="#CFE3D6"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/appCheckboxContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. Accessibility permission on karo"
            android:backgroundTint="#22392F"
            android:textColor="#CFE3D6" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. Start Focus (2 ghante)"
            android:backgroundTint="#6FA98D"
            android:textColor="#0F1C17" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Focus band karo"
            android:backgroundTint="#3A2A2A"
            android:textColor="#F4EFE4" />

    </LinearLayout>
</ScrollView>
